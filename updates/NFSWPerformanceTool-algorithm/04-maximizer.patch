+void TrdMaximize::MaximizeNFSWModel()
+{
+	struct Partial
+	{
+		int t, a, h;
+		const CPart* parts[6];
+		Partial() : t(0), a(0), h(0) { for(int i = 0; i < 6; ++i) parts[i] = 0; }
+	};
+	QVector< const CPart* >* lists[6] = { Engines(), Inductions(), Transmissions(), Suspensions(), Brakes(), Tires() };
+	QMap< QString, Partial > current;
+	Partial first;
+	current.insert("0,0,0", first);
+	for(int slot = 0; slot < 6; ++slot)
+	{
+		QMap< QString, Partial > next;
+		for(QMap< QString, Partial >::const_iterator it = current.begin(); it != current.end(); ++it)
+		{
+			const Partial& base = it.value();
+			for(int p = 0; p < lists[slot]->size(); ++p)
+			{
+				if( !GoOn() ) return;
+				const CPart* part = lists[slot]->at(p);
+				Partial n = base;
+				n.t += part->Topspeed();
+				n.a += part->Acceleration();
+				n.h += part->Handling();
+				n.parts[slot] = part;
+				const QString key = QString("%1,%2,%3").arg(n.t).arg(n.a).arg(n.h);
+				if( !next.contains(key) ) next.insert(key, n);
+			}
+		}
+		current = next;
+		emit Progress(( slot + 1 ) / 7.0f);
+	}
+	int done = 0;
+	const int total = qMax(1, current.size());
+	for(QMap< QString, Partial >::const_iterator it = current.begin(); it != current.end(); ++it)
+	{
+		if( !GoOn() ) return;
+		const Partial& n = it.value();
+		Eval((tPercent)n.t, (tPercent)n.a, (tPercent)n.h,
+			n.parts[0], n.parts[1], n.parts[2], n.parts[3], n.parts[4], n.parts[5]);
+		++done;
+		if( ( done & 255 ) == 0 ) emit Progress(6.0f / 7.0f + ( done / (float)total ) / 7.0f);
+	}
+	emit Progress(1.0f);
+}
