 void TrdAnalyze::ComputeTargetPercents()
 {
+	if( Car() && Car()->HasNFSWPerformanceModel() )
+	{
+		_pTopspeed = _pAcceleration = _pHandling = 0;
+		_aggregateTargets.clear();
+		return;
+	}
 	_pTopspeed = utils::ComputePercentI(1, Car()->Topspeed(), _topspeed);
 	_pAcceleration = utils::ComputePercentI(1, Car()->Acceleration(), _acceleration);
 	_pHandling = utils::ComputePercentI(1, Car()->Handling(), _handling);
 }
 bool TrdAnalyze::CheckTargetPercents()
 {
+	if( Car() && Car()->HasNFSWPerformanceModel() )
+		return true;
+
 	const tValue topspeed = utils::ComputeStatI(1, Car()->Topspeed(), _pTopspeed);
 	const tValue accleration = utils::ComputeStatI(1, Car()->Acceleration(), _pAcceleration);
 	const tValue handling = utils::ComputeStatI(1, Car()->Handling(), _pHandling);
 
 	return ( topspeed == _topspeed ) && ( accleration == _acceleration ) && ( handling == _handling );
+}
+void TrdAnalyze::BuildAggregateTargets()
+{
+	_aggregateTargets.clear();
+	if( !Car() || !Car()->HasNFSWPerformanceModel() )
+		return;
+
+	const QVector< const CPart* >* lists[6] = { Engines(), Inductions(), Transmissions(), Suspensions(), Brakes(), Tires() };
+	int minT = 0, maxT = 0, minA = 0, maxA = 0, minH = 0, maxH = 0;
+	for(int i = 0; i < 6; ++i)
+	{
+		if( !lists[i] || lists[i]->isEmpty() ) return;
+		int loT = 1000000, loA = 1000000, loH = 1000000;
+		int hiT = -1000000, hiA = -1000000, hiH = -1000000;
+		for(int p = 0; p < lists[i]->size(); ++p)
+		{
+			const CPart* part = lists[i]->at(p);
+			loT = qMin(loT, (int)part->Topspeed()); hiT = qMax(hiT, (int)part->Topspeed());
+			loA = qMin(loA, (int)part->Acceleration()); hiA = qMax(hiA, (int)part->Acceleration());
+			loH = qMin(loH, (int)part->Handling()); hiH = qMax(hiH, (int)part->Handling());
+		}
+		minT += loT; maxT += hiT; minA += loA; maxA += hiA; minH += loH; maxH += hiH;
+	}
+	for(int h = minH; h <= maxH && GoOn(); ++h)
+		for(int a = minA; a <= maxA; ++a)
+			for(int t = minT; t <= maxT; ++t)
+			{
+				const GameMath::Result perf = GameMath::CalculateFromSums(Car(), t, a, h);
+				if( qAbs((int)perf.topspeed - (int)_topspeed) <= 1 &&
+					qAbs((int)perf.acceleration - (int)_acceleration) <= 1 &&
+					qAbs((int)perf.handling - (int)_handling) <= 1 )
+				{
+					AggregateTarget x; x.topspeed=t; x.acceleration=a; x.handling=h;
+					_aggregateTargets.append(x);
+				}
+			}
+}
+bool TrdAnalyze::CanReachAggregate(int _Topspeed, int _Acceleration, int _Handling) const
+{
+	for(int i = 0; i < _aggregateTargets.size(); ++i)
+	{
+		const AggregateTarget& x = _aggregateTargets.at(i);
+		if( x.topspeed >= _Topspeed && x.acceleration >= _Acceleration && x.handling >= _Handling ) return true;
+	}
+	return false;
 }
