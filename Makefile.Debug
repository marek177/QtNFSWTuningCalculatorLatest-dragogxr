QMAKE_TARGET  = QtNFSWTuningCalculator
DESTDIR        = debug\ #avoid trailing-slash linebreak
TARGET         = QtNFSWTuningCalculator.exe
DESTDIR_TARGET = debug\QtNFSWTuningCalculator.exe

####### Implicit rules

.SUFFIXES: .cpp .cc .cxx .c

.cpp.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cc.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.cxx.o:
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o $@ $<

.c.o:
	$(CC) -c $(CFLAGS) $(INCPATH) -o $@ $<

####### Build rules

first: all
all: Makefile.Debug  $(DESTDIR_TARGET)

$(DESTDIR_TARGET):  $(OBJECTS) debug/appicon_res.o
	$(LINK) $(LFLAGS) -o $(DESTDIR_TARGET) object_script.QtNFSWTuningCalculator.Debug  $(LIBS)


debug/appicon_res.o: appicon.rc
	windres -i appicon.rc -o debug\appicon_res.o --include-dir=.

qmake:  FORCE
	@$(QMAKE) -win32 -o Makefile.Debug QtNFSWTuningCalculator.pro

